<mujoco model="cart_poleV2">
    <compiler inertiafromgeom="true" angle="radian"/>
    <!--<visual>
        <map force="0.1" zfar="60"/>
        
    </visual>-->

    <default>
        <joint armature="0" damping="0.01" limited="true"/>
        <geom contype="0" friction="0 0 0" rgba="0.7 0.7 0 1"/>
    </default>
    <option gravity="0 0 -9.81" timestep="0.01" iterations="1" ls_iterations="5"/>
    <worldbody>
        <light directional="true" pos="-0.5 0.5 3" dir="0 0 -1"/>
        
        <geom name="rail" pos="0 0 0" quat="0.707 0 0.707 0" rgba="0.3 0.3 0.7 1" size="0.02 1" type="capsule"/>
        <camera name="world" mode="fixed" pos="0 0 5" xyaxes="1 0 0 0 1 0"/>
        <body name="cart" pos="0 0 0">
            <joint axis="1 0 0" limited="true" name="slider" pos="0 0 0" range="-1 1" type="slide"/>
            <geom name="cart" pos="0 0 0" quat="0.707 0 0.707 0" size="0.1 0.1" type="capsule"/>
            <body name="pole" pos="0 0 0">
                <joint axis="0 1 0" limited="false" name="hinge" pos="0 0 0" type="hinge"/>
                <geom fromto="0 0 -0.6 0 0 0" name="cpole" rgba="0 0.7 0.7 1" size="0.045" mass="0.2" type="capsule"/>
                <site name="tip" pos="0 0 -0.6"/>
            </body>
        </body>
    </worldbody>
    <actuator>
        <motor ctrllimited="true" ctrlrange="-50 50" joint="slider" name="slide"/>
    </actuator>
</mujoco>
