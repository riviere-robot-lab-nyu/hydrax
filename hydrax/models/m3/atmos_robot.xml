                                               actuatorgravcomp="true"/>
                                        <geom type="mesh" mesh="link_6" class="visual"/>
                                        <geom type="mesh" mesh="link_6" class="collision"/>
                                        <geom type="mesh" mesh="camera_mount_d405"
                                              pos="0.012 0 0" class="visual"/>
                                        <geom type="mesh" mesh="camera_mount_d405"
                                              pos="0.012 0 0" class="collision"/>
                                        <geom type="box"
                                              size="0.0115 0.021 0.021"
                                              pos="0.0393206 0 0.0569399"
                                              quat="0.984808 0 0.173648 0"
