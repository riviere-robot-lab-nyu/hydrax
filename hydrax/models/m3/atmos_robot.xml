                                        <!-- <body name="left/carriage_left" pos="0.0865 0.023 0"> -->
                                        <body name="left/carriage_left" pos="0.0944375 0.0309385 0">
                                            <inertial pos="0.00169017 -0.00592796 -0.00365701"
                                                      quat="-0.0382691 0.628022 -0.255101 0.734198"
