                    </body>
                </body>
            </body>
        </body>
    </worldbody>

    <contact>
        <exclude body1="left/carriage_right" body2="left/carriage_left"/>
    </contact>

    <actuator>
        <general name="force_x"  joint="slide_x" gear="1" ctrllimited="true" ctrlrange="-30 30"/>
        <general name="force_y"  joint="slide_y" gear="1" ctrllimited="true" ctrlrange="-30 30"/>
        <general name="torque_z" joint="hinge_z" gear="1" ctrllimited="true" ctrlrange="-10 10"/>
        <position name="left/joint_0"  joint="left/joint_0"             class="wxai"/>
        <position name="left/joint_1"  joint="left/joint_1"             class="wxai"/>
        <position name="left/joint_2"  joint="left/joint_2"             class="wxai"/>
        <position name="left/joint_3"  joint="left/joint_3"             class="wxai"/>
        <position name="left/joint_4"  joint="left/joint_4"             class="wxai"/>
        <position name="left/joint_5"  joint="left/joint_5"             class="wxai"/>
        <position name="left/joint_gr" joint="left/right_carriage_joint" class="gripper"/>
        <position name="left/joint_gl" joint="left/left_carriage_joint"  class="gripper"/>
    </actuator>
