                                        <!--<body name="left/carriage_right" pos="0.0865 -0.023 0"> -->
                                        <body name="left/carriage_right" pos="0.0944375 -0.0309385 0">
                                            <inertial pos="0.00169015 0.00592793 0.00201817"
                                                      quat="-0.370973 0.740886 -0.0847721 0.553427"
