<mujoco model="atmos_m3_robot">
    <!-- Standalone (no scene decorations). Same joints/actuators as scene.xml. -->
    <!--<compiler angle="radian" meshdir="meshes" texturedir="meshes" autolimits="true" eulerseq="ZYX"/> -->
    <compiler angle="radian" meshdir="meshes_blender" texturedir="meshes" autolimits="true" eulerseq="ZYX"/>
    <!-- <option timestep="0.01" integrator="implicitfast" gravity="0 0 -9.8" iterations="1"/> -->
    <!-- <option timestep="0.01" gravity="0 0 -9.8" iterations="1" ls_iterations="4"/> -->
    <!--<option timestep="0.01" gravity="0 0 -9.8" iterations="4" ls_iterations="6" integrator="implicitfast"/>-->
    <option timestep="0.015" gravity="0 0 -9.8" iterations="3" ls_iterations="4" integrator="implicitfast"/>
    <!--<option timestep="0.01" gravity="0 0 -9.8" iterations="1" integrator="implicitfast"/>-->

    <asset>
        <texture type="2d" file="trossen_black.png"/>
        <material name="black" texture="trossen_black"/>
	    <!-- <mesh name="atmos"             file="Alpha3_v4_light_2.STL" scale="0.001 0.001 0.001"/>-->
        <mesh name="atmos"             file="m3_light.stl" scale="0.001 0.001 0.001"/>
        <mesh name="base_link"         file="base_link.stl"/>
        <mesh name="link_1"            file="link_1.stl"/>
        <mesh name="link_2"            file="link_2.stl"/>
        <mesh name="link_3"            file="link_3.stl"/>
        <mesh name="link_4"            file="link_4.stl"/>
        <mesh name="link_5"            file="link_5.stl"/>
        <mesh name="link_6"            file="link_6.stl"/>
        <mesh name="carriage_left"     file="carriage_left.stl"/>
        <mesh name="carriage_right"    file="carriage_right.stl"/>
        <mesh name="gripper_right"     file="gripper_right.stl"/>
        <mesh name="gripper_left"      file="gripper_left.stl"/>
        <mesh name="camera_mount_d405" file="camera_mount_d405.stl"/>
    </asset>

    <default>
        <default class="wxai">
            <mesh scale="1.0 1.0 1.0"/>
            <joint axis="0 1 0" frictionloss="0.1" damping="0.2" armature="0.1"/>
            <position kp="100" inheritrange="1" dampratio="0.95" forcerange="-55 55"/>
            <default class="visual">
                <geom type="mesh" contype="0" conaffinity="0" density="0"
                      group="2" material="black"/>
            </default>
            <default class="collision">
                <geom group="3" type="mesh" contype="0" conaffinity="0"/>
            </default>
            <default class="gripper">
                <position kp="50" inheritrange="1" dampratio="1.0" forcerange="-10 10"/>
            </default>
        </default>
    </default>

    <worldbody>
        <body name="atmos" pos="0 0 0">
            <inertial pos="0 0 0.254" xyaxes="0 0 1 -1 0 0"
                      mass="16.8" diaginertia="0.297 0.51 0.56"/>
            <joint name="slide_x" type="slide" axis="1 0 0" damping="0.0"/>
            <joint name="slide_y" type="slide" axis="0 1 0" damping="0.0"/>
            <joint name="hinge_z" type="hinge" axis="0 0 1" damping="0.0"/>
            <geom type="mesh" mesh="atmos" rgba="0.75 0.75 0.75 1"
                  contype="0" conaffinity="0"/>
            <site name="thruster_f" pos=" 0.15  0.0  0.486"
                  xyaxes="1 0 0  0 0 -1" size="0.025" rgba="1.0 0.4 0.2 1"/>
            <site name="thruster_b" pos="-0.15  0.0  0.298"
                  xyaxes="1 0 0  0 0  1" size="0.025" rgba="1.0 0.4 0.2 1"/>
            <site name="thruster_r" pos=" 0.0  -0.15 0.298"
                  xyaxes="0 1 0  0 0  1" size="0.025" rgba="0.2 0.7 1.0 1"/>
            <site name="thruster_l" pos=" 0.0   0.15 0.298"
                  xyaxes="0 1 0  0 0 -1" size="0.025" rgba="0.2 0.7 1.0 1"/>
            <site name="body_com"   pos="0 0 0.254" size="0.01" rgba="0 1 0 1"/>

	    <!-- <body name="left/root" pos="0.0 0.0 0.54293930455"
	    quat="0.70710678118 0 0 0.70710678118">-->
