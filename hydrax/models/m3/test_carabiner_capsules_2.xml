<mujoco model="test_carabiner_capsules_2">
  <compiler angle="radian" meshdir="meshes_blender" autolimits="true"/>

  <asset>
    <mesh name="carabiner_visual" file="simplified/simplified_carabiner/simplified_carabiner.obj" scale="0.001 0.001 0.001"/>
  </asset>

  <visual>
    <headlight ambient="0.4 0.4 0.4" diffuse="0.7 0.7 0.7" specular="0.1 0.1 0.1"/>
  </visual>

  <worldbody>
    <light pos="0 0 1" dir="0 0 -1" diffuse="0.7 0.7 0.7"/>

    <!-- Semi-transparent carabiner visual (alpha=0.35) -->
    <geom type="mesh" mesh="carabiner_visual" rgba="0.85 0.75 0.25 0.35"
          contype="0" conaffinity="0"/>

    <!-- New 4-capsule decomposition from sketch -->

    <!-- (1) Top arc: one horizontal capsule across the top of the hook (shifted up so inner surface hugs hook ID) -->
    <geom type="capsule"
          fromto="-0.00199  0.07200 -0.04200  -0.00199  0.07200  0.03800"
          size="0.01500" rgba="1 0.5 0 0.6" contype="0" conaffinity="0"/>

    <!-- (2) Gate-inner: small vertical capsule on the inside-left of the hook opening (shortened, doesn't extend past gate cut) -->
    <geom type="capsule"
          fromto="-0.00199  0.05000 -0.04200  -0.00199  0.03200 -0.04200"
          size="0.01100" rgba="0 1 1 0.6" contype="0" conaffinity="0"/>

    <!-- (3) Spine: large vertical capsule covering the main body (shifted outward +z so it matches hook ID and prism OD) -->
    <geom type="capsule"
          fromto="-0.01692 -0.07000  0.05000  -0.01692  0.02200  0.05000"
          size="0.04000" rgba="1 0 1 0.6" contype="0" conaffinity="0"/>

    <!-- (4) Bottom diagonal: angled capsule covering the bottom curve (lower-left to upper-right of bottom) -->
    <geom type="capsule"
          fromto=" 0.00000 -0.07000 -0.06000   0.00000 -0.04000 -0.01000"
          size="0.02400" rgba="0 0 1 0.6" contype="0" conaffinity="0"/>
  </worldbody>
</mujoco>
